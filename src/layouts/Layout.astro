---
// src/layouts/Layout.astro
import Logo from '../components/Logo.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "NeuralCraft Engine — Conception de webapps complexes, performantes et sur-mesure. Fullstack, temps réel, architectures distribuées.",
  ogImage = "/og-default.png",
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site ?? 'https://neuralcraft.fr');
const fullTitle = `${title} | NeuralCraft Engine`;
---

<!DOCTYPE html>
<html lang="fr" class="dark bg-slate-950 text-slate-100 antialiased selection:bg-emerald-500 selection:text-slate-950 min-h-screen">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO de base -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="NeuralCraft Engine" />
  <meta name="theme-color" content="#34d399" />

  <!-- Open Graph (LinkedIn, Facebook, Discord, Slack…) -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={new URL(ogImage, Astro.site ?? 'https://neuralcraft.fr')} />
  <meta property="og:locale"      content="fr_FR" />
  <meta property="og:site_name"   content="NeuralCraft Engine" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={new URL(ogImage, Astro.site ?? 'https://neuralcraft.fr')} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon"  href="/favicon.ico" />

  <!-- Typographies Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <ClientRouter />
</head>

<body class="font-sans min-h-screen flex flex-col justify-between overflow-x-hidden">

  <!-- Halo lumineux d'ambiance -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-emerald-500/10 blur-[150px] rounded-full pointer-events-none -z-10"></div>

  <!-- HEADER -->
  <header class="fixed top-0 left-0 w-full z-50 px-5 py-4 backdrop-blur-xl bg-slate-950/60 border-b border-slate-800/40">
    <div class="w-full max-w-7xl mx-auto flex items-center justify-between">

      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <Logo class="w-8 h-8 group-hover:scale-110 transition-transform duration-300" />
        <span class="font-heading font-extrabold text-lg tracking-tight text-slate-100">
          Neural<span class="text-emerald-400">Craft</span>
        </span>
      </a>

      <!-- Navigation desktop -->
      <nav class="hidden md:flex items-center gap-10 text-sm font-medium tracking-wide">
        <a href="/services" class={`hover:text-emerald-400 transition-all py-1 relative ${currentPath === '/services' ? 'text-emerald-400 font-semibold' : 'text-slate-400'}`}>
          Services
          {currentPath === '/services' && <span class="absolute bottom-0 left-0 w-full h-[2px] bg-emerald-400 rounded-full"></span>}
        </a>
        <a href="/projets" class={`hover:text-emerald-400 transition-all py-1 relative ${currentPath === '/projets' ? 'text-emerald-400 font-semibold' : 'text-slate-400'}`}>
          Réalisations
          {currentPath === '/projets' && <span class="absolute bottom-0 left-0 w-full h-[2px] bg-emerald-400 rounded-full"></span>}
        </a>
        <a href="/approche" class={`hover:text-emerald-400 transition-all py-1 relative ${currentPath === '/approche' ? 'text-emerald-400 font-semibold' : 'text-slate-400'}`}>
          Approche
          {currentPath === '/approche' ? <span class="absolute bottom-0 left-0 w-full h-[2px] bg-emerald-400 rounded-full"></span> : ''}
        </a>
      </nav>

      <!-- Burger button (mobile only) -->
      <button id="burger-btn" class="md:hidden flex flex-col gap-[5px] p-2 rounded-lg hover:bg-slate-800/60 transition-colors" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="burger-line w-5 h-[2px] bg-slate-200 rounded-full transition-all duration-300 origin-center"></span>
        <span class="burger-line w-5 h-[2px] bg-slate-200 rounded-full transition-all duration-300 origin-center"></span>
        <span class="burger-line w-5 h-[2px] bg-slate-200 rounded-full transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </header>

  <!-- MOBILE MENU OVERLAY -->
  <div id="mobile-menu" class="mobile-menu fixed inset-0 z-40 flex flex-col bg-slate-950/95 backdrop-blur-2xl" aria-hidden="true">
    <!-- Top bar avec logo et close -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-slate-800/40">
      <a href="/" class="flex items-center gap-2.5">
        <Logo class="w-8 h-8" />
        <span class="font-heading font-extrabold text-lg tracking-tight text-slate-100">
          Neural<span class="text-emerald-400">Craft</span>
        </span>
      </a>
      <button id="menu-close" class="p-2 rounded-lg hover:bg-slate-800/60 transition-colors" aria-label="Fermer le menu">
        <svg class="w-6 h-6 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <!-- Nav links -->
    <nav class="flex flex-col items-start justify-center flex-1 px-8 gap-2">
      <a href="/" class="mobile-nav-link w-full py-4 border-b border-slate-800/30 text-3xl font-heading font-extrabold text-slate-100 hover:text-emerald-400 transition-colors tracking-tight">Accueil</a>
      <a href="/services" class="mobile-nav-link w-full py-4 border-b border-slate-800/30 text-3xl font-heading font-extrabold text-slate-100 hover:text-emerald-400 transition-colors tracking-tight">Services</a>
      <a href="/projets" class="mobile-nav-link w-full py-4 border-b border-slate-800/30 text-3xl font-heading font-extrabold text-slate-100 hover:text-emerald-400 transition-colors tracking-tight">Réalisations</a>
      <a href="/approche" class="mobile-nav-link w-full py-4 text-3xl font-heading font-extrabold text-slate-100 hover:text-emerald-400 transition-colors tracking-tight">Approche</a>
    </nav>
    <!-- Bas du menu -->
    <div class="px-8 py-8 border-t border-slate-800/40">
      <p class="text-xs font-mono text-slate-600 uppercase tracking-widest">NeuralCraft Engine &mdash; 2025</p>
    </div>
  </div>

  <!-- CONTENEUR GLOBAL -->
  <main transition:animate="fade" class="flex-1 pt-20">
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800/50 bg-slate-950/60 backdrop-blur-sm">
    <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">

      <!-- Brand -->
      <div class="flex items-center gap-2 text-slate-500">
        <span class="font-heading font-bold text-sm text-slate-400">Neural<span class="text-emerald-400">Craft</span></span>
        <span class="text-slate-700">—</span>
        <span class="text-xs" id="footer-copy">© 2025 Tous droits réservés</span>
      </div>

      <!-- Nav secondaire -->
      <nav class="flex items-center gap-6 text-xs text-slate-600">
        <a href="/services" class="hover:text-slate-400 transition-colors">Services</a>
        <a href="/projets"  class="hover:text-slate-400 transition-colors">Réalisations</a>
        <a href="/approche" class="hover:text-slate-400 transition-colors">Approche</a>
      </nav>

    </div>
  </footer>

  <!-- SCRIPT BURGER MENU + LENIS -->
  <script>
    import Lenis from 'lenis';

    // ── Lenis smooth scroll ──────────────────────────
    function initLenis() {
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });
      function raf(time: number) { lenis.raf(time); requestAnimationFrame(raf); }
      requestAnimationFrame(raf);
    }
    initLenis();
    document.addEventListener('astro:after-swap', initLenis);

    // ── Burger menu ──────────────────────────────────
    function initBurger() {
      const burger   = document.getElementById('burger-btn');
      const closeBtn = document.getElementById('menu-close');
      const menu     = document.getElementById('mobile-menu');
      const links    = menu?.querySelectorAll('.mobile-nav-link');

      const open = () => {
        menu?.classList.add('is-open');
        burger?.setAttribute('aria-expanded', 'true');
        menu?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        menu?.classList.remove('is-open');
        burger?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };

      burger?.addEventListener('click', open);
      closeBtn?.addEventListener('click', close);
      links?.forEach(l => l.addEventListener('click', close));

      // Fermer avec Escape
      document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
    }
    initBurger();
    document.addEventListener('astro:after-swap', initBurger);
  </script>

  <script>
    // Année copyright auto-mise à jour
    const el = document.getElementById('footer-copy');
    if (el) el.textContent = `© ${new Date().getFullYear()} Tous droits réservés`;
    document.addEventListener('astro:after-swap', () => {
      const e = document.getElementById('footer-copy');
      if (e) e.textContent = `© ${new Date().getFullYear()} Tous droits réservés`;
    });
  </script>


</body>
</html>
---
// src/layouts/Layout.astro
import Logo from '../components/Logo.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="fr" class="dark bg-slate-950 text-slate-100 antialiased selection:bg-emerald-500 selection:text-slate-950 min-h-screen">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | NeuralCraft Engine</title>
  
  <!-- Duo de Typographies Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <ClientRouter />
</head>
<body class="font-sans min-h-screen flex flex-col justify-between overflow-x-hidden">

  <!-- Halo lumineux d'ambiance -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-emerald-500/10 blur-[150px] rounded-full pointer-events-none -z-10"></div>

  <!-- HEADER NOUVELLE GÉNÉRATION (Sans bouton parasite, épuré) -->
  <header class="fixed top-0 left-0 w-full z-50 px-6 py-5 backdrop-blur-xl bg-slate-950/40 border-b border-slate-800/40">
    <div class="w-full max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <Logo class="w-8 h-8 group-hover:scale-110 transition-transform duration-300" />
        <span class="font-heading font-extrabold text-lg md:text-xl tracking-tight text-slate-100">
          Neural<span class="text-emerald-400">Craft</span>
        </span>
      </a>

      <!-- Navigation Épurée -->
      <nav class="flex items-center gap-8 md:gap-12 text-xs md:text-sm font-medium tracking-wide">
        <a href="/services" class={`hover:text-emerald-400 transition-all py-1 relative ${currentPath === '/services' ? 'text-emerald-400 font-semibold' : 'text-slate-400'}`}>
          Services
          {currentPath === '/services' && <span class="absolute bottom-0 left-0 w-full h-[2px] bg-emerald-400 rounded-full"></span>}
        </a>
        <a href="/projets" class={`hover:text-emerald-400 transition-all py-1 relative ${currentPath === '/projets' ? 'text-emerald-400 font-semibold' : 'text-slate-400'}`}>
          Réalisations
          {currentPath === '/projets' && <span class="absolute bottom-0 left-0 w-full h-[2px] bg-emerald-400 rounded-full"></span>}
        </a>
        <a href="/approche" class={`hover:text-emerald-400 transition-all py-1 relative ${currentPath === '/approche' ? 'text-emerald-400 font-semibold' : 'text-slate-400'}`}>
          Approche
          {currentPath === '/approche' ? <span class="absolute bottom-0 left-0 w-full h-[2px] bg-emerald-400 rounded-full"></span> : ''}
        </a>
      </nav>

    </div>
  </header>

  <!-- CONTENEUR GLOBAL -->
  <main transition:animate="fade" class="flex-1 pt-20">
    <slot />
  </main>

  <!-- SCRIPT LENIS SMOOTH SCROLL -->
  <script>
    import Lenis from 'lenis';

    function initLenis() {
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    }

    initLenis();
    document.addEventListener('astro:after-swap', initLenis);
  </script>

</body>
</html>
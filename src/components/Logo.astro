---
// src/components/Logo.astro
interface Props {
  class?: string;
  id?: string;
}

const { class: className = "w-12 h-12", id = "hero-logo-svg" } = Astro.props;
---

<div class={`relative flex items-center justify-center shrink-0 ${className}`}>
  <svg id={id} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full transition-transform duration-300">
    <!-- Tracé du N -->
    <path d="M25 75 L25 25 L75 75 L75 25" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400 animate-path" />
    
    <!-- Ondes d'impact -->
    <circle cx="25" cy="75" r="8" stroke="currentColor" stroke-width="1.5" class="text-emerald-400 node-pulse p-1" />
    <circle cx="25" cy="25" r="8" stroke="currentColor" stroke-width="1.5" class="text-emerald-400 node-pulse p-2" />
    <circle cx="75" cy="75" r="8" stroke="currentColor" stroke-width="1.5" class="text-emerald-400 node-pulse p-3" />
    <circle cx="75" cy="25" r="8" stroke="currentColor" stroke-width="1.5" class="text-emerald-400 node-pulse p-4" />

    <!-- Nœuds physiques -->
    <circle cx="25" cy="75" r="5" fill="#0F172A" stroke="currentColor" stroke-width="2.5" class="text-emerald-400 node-pop n-1" />
    <circle cx="25" cy="25" r="5" fill="#0F172A" stroke="currentColor" stroke-width="2.5" class="text-emerald-400 node-pop n-2" />
    <circle cx="75" cy="75" r="5" fill="#0F172A" stroke="currentColor" stroke-width="2.5" class="text-emerald-400 node-pop n-3" />
    <circle cx="75" cy="25" r="5" fill="#0F172A" stroke="currentColor" stroke-width="2.5" class="text-emerald-400 node-pop n-4" />
    
    <!-- Cœur central -->
    <circle cx="50" cy="50" r="4" class="fill-emerald-400 core-plug" />
  </svg>
</div>

<style>
  /* ANIMATIONS ENTRANTES (Initiales) */
  .animate-path {
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: drawLineA 1.3s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.2s;
  }
  @keyframes drawLineA { to { stroke-dashoffset: 0; } }

  .node-pop {
    transform-origin: center;
    transform: scale(0);
    animation: popIn 0.5s cubic-bezier(0.34, 1.8, 0.64, 1) forwards;
  }
  .n-1 { animation-delay: 0.2s; }
  .n-2 { animation-delay: 0.6s; }
  .n-3 { animation-delay: 1.1s; }
  .n-4 { animation-delay: 1.4s; }
  @keyframes popIn { to { transform: scale(1); } }

  .node-pulse {
    transform-origin: center;
    transform: scale(0);
    opacity: 0;
    animation: nodePulseA 0.6s ease-out forwards;
  }
  .p-1 { animation-delay: 0.2s; }
  .p-2 { animation-delay: 0.6s; }
  .p-3 { animation-delay: 1.1s; }
  .p-4 { animation-delay: 1.4s; }
  @keyframes nodePulseA {
    0% { transform: scale(0.5); opacity: 0.9; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  .core-plug {
    transform-origin: center;
    transform: scale(0);
    animation: corePlug 0.8s cubic-bezier(0.34, 2, 0.64, 1) forwards 1.5s;
  }
  @keyframes corePlug {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.8); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* CLASS DE DÉCONSTRUCTION / RUPTURE (Effet Clic Inverse) */
  svg.deconstruct .animate-path {
    animation: eraseLine 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards !important;
  }
  @keyframes eraseLine {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: 220; }
  }

  svg.deconstruct .node-pop {
    animation: popOut 0.4s ease-in forwards !important;
  }
  @keyframes popOut {
    to { transform: scale(0); opacity: 0; }
  }

  svg.deconstruct .core-plug {
    animation: coreUnplug 0.3s ease-in forwards !important;
  }
  @keyframes coreUnplug {
    to { transform: scale(3); opacity: 0; }
  }
</style>
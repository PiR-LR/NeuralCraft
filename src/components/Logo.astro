---
// src/components/Logo.astro
interface Props {
  class?: string;
  id?: string;
  autoplay?: boolean;
}

const {
  class: className = "w-12 h-12",
  id = "hero-logo-svg",
  autoplay = true,
} = Astro.props;

const safeId = id.replace(/[^a-zA-Z0-9_-]/g, "") || "hero-logo-svg";
const gradientId = `${safeId}-energy-gradient`;
---

<div
  class={`relative flex items-center justify-center shrink-0 ${className}`}
  data-neuralcraft-logo
>
  <!-- Canvas pour les particules -->
  <canvas
    data-logo-particles
    class="absolute inset-0 w-full h-full pointer-events-none z-20"
    style="mix-blend-mode: screen;"
  ></canvas>

  <svg
    id={safeId}
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full transition-transform duration-300 relative z-10"
    data-logo-svg
    data-autoplay={autoplay ? "true" : "false"}
    style="overflow: visible;"
  >
    <defs>
      <linearGradient id={gradientId} x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#34d399" />
        <stop offset="50%" stop-color="#2dd4bf" />
        <stop offset="100%" stop-color="#22d3ee" />
      </linearGradient>
    </defs>

    <!-- Tracé principal du N -->
    <path
      data-logo-line
      d="M25 75 L25 25 L75 75 L75 25"
      stroke="currentColor"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-emerald-400"
    ></path>

    <!-- Flux énergétique (comète) -->
    <path
      data-logo-energy
      d="M25 75 L25 25 L75 75 L75 25"
      stroke={`url(#${gradientId})`}
      stroke-width="5.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="pointer-events-none opacity-0"
      style="filter: drop-shadow(0 0 8px rgba(45, 212, 191, 0.6));"
    ></path>

    <!-- Ondes de choc (burst) -->
    <circle data-logo-shockwave cx="50" cy="50" r="5" stroke="#34d399" stroke-width="2" fill="none" opacity="0"></circle>
    <circle data-logo-shockwave cx="50" cy="50" r="5" stroke="#2dd4bf" stroke-width="1.5" fill="none" opacity="0"></circle>

    <!-- Ondes d'impact nœuds -->
    <circle data-logo-wave cx="25" cy="75" r="8" stroke="currentColor" stroke-width="1.5" class="text-emerald-400 pointer-events-none"></circle>
    <circle data-logo-wave cx="25" cy="25" r="8" stroke="currentColor" stroke-width="1.5" class="text-emerald-400 pointer-events-none"></circle>
    <circle data-logo-wave cx="75" cy="75" r="8" stroke="currentColor" stroke-width="1.5" class="text-emerald-400 pointer-events-none"></circle>
    <circle data-logo-wave cx="75" cy="25" r="8" stroke="currentColor" stroke-width="1.5" class="text-emerald-400 pointer-events-none"></circle>

    <!-- Nœuds physiques -->
    <circle data-logo-node cx="25" cy="75" r="5" fill="#0F172A" stroke="currentColor" stroke-width="2.5" class="text-emerald-400"></circle>
    <circle data-logo-node cx="25" cy="25" r="5" fill="#0F172A" stroke="currentColor" stroke-width="2.5" class="text-emerald-400"></circle>
    <circle data-logo-node cx="75" cy="75" r="5" fill="#0F172A" stroke="currentColor" stroke-width="2.5" class="text-emerald-400"></circle>
    <circle data-logo-node cx="75" cy="25" r="5" fill="#0F172A" stroke="currentColor" stroke-width="2.5" class="text-emerald-400"></circle>

    <!-- Halo du cœur -->
    <circle data-logo-halo cx="50" cy="50" r="12" fill="#34d399" opacity="0" class="pointer-events-none"></circle>

    <!-- Cœur central -->
    <circle data-logo-core cx="50" cy="50" r="4" class="fill-emerald-400"></circle>
  </svg>
</div>

<style>
  [data-neuralcraft-logo] [data-logo-core] {
    filter: drop-shadow(0 0 12px rgb(52 211 153 / 0.6));
  }
  [data-neuralcraft-logo] [data-logo-energy] {
    mix-blend-mode: screen;
  }
</style>

<script>
  import anime from "animejs";

  const cleanups = new Set<() => void>();

  // --- PARTICLE SYSTEM (avec support DPR Retina) ---
  class ParticleSystem {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    particles: any[] = [];
    animId: number | null = null;
    running = false;
    dpr: number = 1;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext("2d")!;
      this.dpr = window.devicePixelRatio || 1;
      this.resize();
    }

    resize() {
      const rect = this.canvas.parentElement?.getBoundingClientRect();
      if (!rect) return;

      // Taille logique (ce que voit l'utilisateur)
      const width = rect.width;
      const height = rect.height;

      // Taille physique (pixels réels pour netteté Retina)
      this.canvas.width = width * this.dpr;
      this.canvas.height = height * this.dpr;

      // Mise à l'échelle du contexte pour dessiner en coordonnées logiques
      this.ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
    }

    emit(x: number, y: number, count: number, color: string, speed = 3) {
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const velocity = (Math.random() * 0.5 + 0.5) * speed;
        this.particles.push({
          x,
          y,
          vx: Math.cos(angle) * velocity,
          vy: Math.sin(angle) * velocity,
          life: 1,
          decay: Math.random() * 0.02 + 0.015,
          size: Math.random() * 3 + 1,
          color,
        });
      }
      if (!this.running) this.start();
    }

    start() {
      this.running = true;
      const rect = this.canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;

      const loop = () => {
        this.ctx.clearRect(0, 0, w, h);
        this.particles = this.particles.filter((p) => p.life > 0);

        for (const p of this.particles) {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.02; // gravité légère
          p.life -= p.decay;

          this.ctx.beginPath();
          this.ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
          this.ctx.fillStyle = p.color;
          this.ctx.globalAlpha = p.life;
          this.ctx.fill();
        }
        this.ctx.globalAlpha = 1;

        if (this.particles.length > 0) {
          this.animId = requestAnimationFrame(loop);
        } else {
          this.running = false;
        }
      };
      loop();
    }

    stop() {
      if (this.animId) cancelAnimationFrame(this.animId);
      this.running = false;
      this.particles = [];
    }
  }

  function setupLogo(root: HTMLElement) {
    if (root.dataset.ncLogoInitialized === "true") return;
    root.dataset.ncLogoInitialized = "true";

    const svg = root.querySelector<SVGSVGElement>("[data-logo-svg]");
    const canvas = root.querySelector<HTMLCanvasElement>("[data-logo-particles]");
    if (!svg) return;

    const particleSys = canvas ? new ParticleSystem(canvas) : null;

    const line = svg.querySelector<SVGPathElement>("[data-logo-line]");
    const energy = svg.querySelector<SVGPathElement>("[data-logo-energy]");
    const waves = Array.from(svg.querySelectorAll<SVGCircleElement>("[data-logo-wave]"));
    const nodes = Array.from(svg.querySelectorAll<SVGCircleElement>("[data-logo-node]"));
    const core = svg.querySelector<SVGCircleElement>("[data-logo-core]");
    const halo = svg.querySelector<SVGCircleElement>("[data-logo-halo]");
    const shockwaves = Array.from(svg.querySelectorAll<SVGCircleElement>("[data-logo-shockwave]"));

    const targets = [line, energy, ...waves, ...nodes, core, halo, ...shockwaves].filter(Boolean) as Element[];
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const lineLength = line ? line.getTotalLength() : 200;

    let entrance: any = null;
    let burst: any = null;
    let idleCore: any = null;
    let idleEnergy: any = null;
    let idleHalo: any = null;
    let busy = false;

    const nodePositions = [
      { x: 25, y: 75 },
      { x: 25, y: 25 },
      { x: 75, y: 75 },
      { x: 75, y: 25 },
    ];

    const applyTransformBox = () => {
      targets.forEach((el) => {
        const element = el as SVGElement;
        element.style.transformBox = "fill-box";
        element.style.transformOrigin = "center";
      });
    };

    const stopIdle = () => {
      [idleCore, idleEnergy, idleHalo].forEach((anim) => anim && anim.pause());
      idleCore = null;
      idleEnergy = null;
      idleHalo = null;
    };

    const emitParticlesAtNodes = (count: number, speed: number) => {
      if (!particleSys || !canvas) return;
      const rect = canvas.getBoundingClientRect();
      const scaleX = rect.width / 100;
      const scaleY = rect.height / 100;
      const colors = ["#34d399", "#2dd4bf", "#22d3ee"];
      nodePositions.forEach((pos) => {
        const color = colors[Math.floor(Math.random() * colors.length)];
        particleSys.emit(pos.x * scaleX, pos.y * scaleY, count, color, speed);
      });
    };

    const emitParticlesAtCore = (count: number, speed: number) => {
      if (!particleSys || !canvas) return;
      const rect = canvas.getBoundingClientRect();
      const scaleX = rect.width / 100;
      const scaleY = rect.height / 100;
      particleSys.emit(50 * scaleX, 50 * scaleY, count, "#34d399", speed);
    };

    const screenShake = () => {
      if (!root) return;
      anime.remove(root);
      anime({
        targets: root,
        translateX: [
          { value: -4, duration: 50 },
          { value: 4, duration: 50 },
          { value: -2, duration: 50 },
          { value: 2, duration: 50 },
          { value: 0, duration: 50 },
        ],
        easing: "linear",
      });
    };

    const startIdle = () => {
      if (prefersReducedMotion) return;
      stopIdle();

      if (core) {
        idleCore = anime({
          targets: core,
          scale: [1, 1.15],
          duration: 1400,
          direction: "alternate",
          loop: true,
          easing: "easeInOutSine",
        });
      }
      if (halo) {
        idleHalo = anime({
          targets: halo,
          opacity: [0.08, 0.18],
          scale: [0.92, 1.1],
          duration: 1700,
          direction: "alternate",
          loop: true,
          easing: "easeInOutSine",
        });
      }
      if (energy) {
        anime.set(energy, {
          strokeDasharray: `${lineLength * 0.18} ${lineLength * 0.82}`,
          strokeDashoffset: lineLength,
          opacity: 0,
        });
        idleEnergy = anime({
          targets: energy,
          strokeDashoffset: [lineLength, -lineLength],
          duration: 3200,
          easing: "linear",
          loop: true,
          opacity: [
            { value: 0, duration: 120 },
            { value: 0.75, duration: 400 },
            { value: 0.75, duration: 2200 },
            { value: 0, duration: 480 },
          ],
        });
      }
    };

    const setAssembled = () => {
      if (line) anime.set(line, { strokeDasharray: lineLength, strokeDashoffset: 0, opacity: 1 });
      if (energy) anime.set(energy, { opacity: 0, strokeDasharray: `${lineLength * 0.18} ${lineLength * 0.82}`, strokeDashoffset: lineLength });
      anime.set(nodes, { opacity: 1, scale: 1, translateX: 0, translateY: 0 });
      anime.set(waves, { opacity: 0, scale: 0.4 });
      anime.set(shockwaves, { opacity: 0, scale: 1 });
      if (core) anime.set(core, { opacity: 1, scale: 1 });
      if (halo) anime.set(halo, { opacity: 0.1, scale: 1 });
    };

    const playEntrance = () => {
      if (busy) return;
      if (prefersReducedMotion) {
        setAssembled();
        return;
      }
      busy = true;
      stopIdle();
      if (entrance) entrance.pause();
      if (burst) burst.pause();
      anime.remove(targets);

      if (line) anime.set(line, { strokeDasharray: lineLength, strokeDashoffset: lineLength, opacity: 1 });
      if (energy) anime.set(energy, { opacity: 0, strokeDasharray: `${lineLength * 0.18} ${lineLength * 0.82}`, strokeDashoffset: lineLength });
      anime.set(nodes, { opacity: 0, scale: 0, translateY: -60 });
      anime.set(waves, { opacity: 0, scale: 0.4 });
      anime.set(shockwaves, { opacity: 0, scale: 1 });
      if (core) anime.set(core, { opacity: 0, scale: 0 });
      if (halo) anime.set(halo, { opacity: 0, scale: 0.3 });

      entrance = anime.timeline({
        complete: () => {
          busy = false;
          startIdle();
        },
      });

      entrance.add({
        targets: line,
        strokeDashoffset: [lineLength, 0],
        duration: 1300,
        easing: "easeInOutQuart",
      });

      entrance.add({
        targets: nodes,
        translateY: [-60, 0],
        opacity: [0, 1],
        scale: [0, 1],
        duration: 900,
        delay: anime.stagger(100, { from: "center" }),
        easing: "easeOutElastic(1, .7)",
      }, 600);

      waves.forEach((wave, i) => {
        entrance.add({
          targets: wave,
          opacity: [0.85, 0],
          scale: [0.4, 2.4],
          duration: 650,
          easing: "easeOutQuad",
        }, 700 + i * 100);
      });

      entrance.add({
        targets: core,
        opacity: [0, 1],
        scale: [0, 1.6, 1],
        duration: 700,
        easing: "easeOutElastic(1, .6)",
      }, 1200);

      entrance.add({
        targets: halo,
        opacity: [0, 0.12],
        scale: [0.3, 1],
        duration: 550,
        easing: "easeOutQuad",
      }, 1300);

      setTimeout(() => emitParticlesAtCore(12, 2), 1300);
    };

    const playBurst = () => {
      if (busy || prefersReducedMotion) return;
      busy = true;
      stopIdle();
      if (entrance) entrance.pause();
      if (burst) burst.pause();
      anime.remove(targets);
      setAssembled();

      burst = anime.timeline({
        complete: () => {
          busy = false;
          startIdle();
        },
      });

      burst.add({
        targets: core,
        scale: [1, 1.8],
        duration: 180,
        easing: "easeOutQuad",
      }, 0);

      burst.add({
        targets: halo,
        opacity: [0.1, 0.45],
        scale: [1, 1.8],
        duration: 220,
        easing: "easeOutQuad",
      }, 0);

      setTimeout(() => {
        screenShake();
        emitParticlesAtCore(25, 4);
        emitParticlesAtNodes(10, 3);
      }, 80);

      shockwaves.forEach((sw, i) => {
        burst.add({
          targets: sw,
          opacity: [0.65 - i * 0.15, 0],
          scale: [1, 4.5 + i],
          duration: 650,
          easing: "easeOutExpo",
        }, 80 + i * 70);
      });

      burst.add({
        targets: line,
        strokeDashoffset: [0, lineLength],
        duration: 450,
        easing: "easeInQuad",
      }, 140);

      burst.add({
        targets: nodes,
        opacity: [1, 0],
        scale: [1, 0.2],
        duration: 320,
        delay: anime.stagger(30, { from: "center" }),
        easing: "easeInQuad",
      }, 160);

      burst.add({
        targets: core,
        opacity: [1, 0],
        scale: [1.8, 0],
        duration: 280,
        easing: "easeInQuad",
      }, 200);

      burst.add({
        targets: line,
        strokeDashoffset: [lineLength, 0],
        duration: 650,
        easing: "easeOutQuart",
      }, 750);

      burst.add({
        targets: nodes,
        opacity: [0, 1],
        scale: [0, 1],
        translateY: 0,
        duration: 750,
        easing: "easeOutElastic(1, .6)",
        delay: anime.stagger(55, { from: "center" }),
      }, 850);

      waves.forEach((wave, i) => {
        burst.add({
          targets: wave,
          opacity: [0.75, 0],
          scale: [0.4, 2.2],
          duration: 580,
          easing: "easeOutQuad",
        }, 950 + i * 75);
      });

      burst.add({
        targets: core,
        opacity: [0, 1],
        scale: [0, 1.4, 1],
        duration: 650,
        easing: "easeOutElastic(1, .7)",
      }, 1150);

      burst.add({
        targets: halo,
        opacity: [0, 0.12],
        scale: [0.5, 1],
        duration: 500,
        easing: "easeOutQuad",
      }, 1250);

      setTimeout(() => {
        emitParticlesAtNodes(6, 2);
        emitParticlesAtCore(8, 2);
      }, 950);
    };

    // --- GESTION RESPONSIVE : resize + DPR ---
    const handleResize = () => {
      particleSys?.resize();
    };
    window.addEventListener("resize", handleResize);
    window.addEventListener("orientationchange", handleResize);

    const destroy = () => {
      stopIdle();
      if (entrance) entrance.pause();
      if (burst) burst.pause();
      if (particleSys) particleSys.stop();
      anime.remove(targets);
      delete (svg as any).ncLogo;
      root.dataset.ncLogoInitialized = "false";
      window.removeEventListener("resize", handleResize);
      window.removeEventListener("orientationchange", handleResize);
    };

    (svg as any).ncLogo = { playEntrance, playBurst, destroy };
    applyTransformBox();

    if (svg.dataset.autoplay !== "false") {
      requestAnimationFrame(playEntrance);
    } else {
      setAssembled();
    }
    cleanups.add(destroy);
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>("[data-neuralcraft-logo]").forEach(setupLogo);
  }
  function cleanupAll() {
    cleanups.forEach((cleanup) => cleanup());
    cleanups.clear();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAll);
  } else {
    initAll();
  }
  document.addEventListener("astro:before-swap", cleanupAll);
  document.addEventListener("astro:after-swap", initAll);
</script>
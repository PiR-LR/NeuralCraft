---
// src/components/ContactModal.astro
---

<div
  id="contact-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 bg-slate-950/85 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-300"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="contact-modal-title"
>
  <!-- Card Modale -->
  <div
    id="contact-modal-card"
    class="relative w-full max-w-lg bg-slate-900/95 border border-emerald-500/30 rounded-3xl p-5 sm:p-7 shadow-[0_0_60px_-10px_rgba(52,211,153,0.25)] overflow-hidden scale-95 transition-all duration-300 max-h-[92vh] overflow-y-auto custom-modal-scroll"
    style="scrollbar-width: none; -ms-overflow-style: none;"
  >
    <!-- Halo lumineux ambiant -->
    <div class="absolute -top-24 -right-24 w-60 h-60 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-60 h-60 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400"></div>

    <!-- Bouton Fermer (Z-40 et cursor-pointer garanti) -->
    <button
      id="contact-modal-close"
      type="button"
      class="absolute top-4 right-4 z-40 w-10 h-10 rounded-full bg-slate-800/90 border border-slate-700/80 flex items-center justify-center text-slate-400 hover:text-emerald-400 hover:border-emerald-500/50 hover:rotate-90 transition-all duration-300 cursor-pointer"
      aria-label="Fermer la fenêtre"
    >
      <svg class="w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- ÉTAT 1 : Formulaire -->
    <div id="contact-form-container" class="relative z-10 space-y-4 pt-1">
      <div class="space-y-1.5 pr-10">
        <span class="inline-block text-[10px] font-mono uppercase tracking-[0.25em] text-emerald-400 border border-emerald-500/20 rounded-full px-3 py-0.5 bg-emerald-500/5">
          Contact direct
        </span>
        <h2 id="contact-modal-title" class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-100">
          Parlons de votre <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">projet</span>
        </h2>
        <p class="text-slate-400 text-xs leading-relaxed">
          Décrivez votre activité et ce que vous souhaitez créer. Je vous répondrai pour en discuter.
        </p>
      </div>

      <form id="contact-form" class="space-y-4">
        <!-- Type de projet (Chips cliquables) -->
        <div class="space-y-2">
          <label class="block text-xs font-mono uppercase tracking-wider text-slate-300">Type de projet</label>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="project-type-chips">
            <button
              type="button"
              data-type="Site Web"
              class="project-chip active text-xs font-medium py-2 px-3 rounded-xl border border-emerald-500/60 bg-emerald-500/10 text-emerald-300 transition-all text-center"
            >
              Site Vitrine
            </button>
            <button
              type="button"
              data-type="Webapp"
              class="project-chip text-xs font-medium py-2 px-3 rounded-xl border border-slate-800 bg-slate-950/60 text-slate-400 hover:border-slate-700 hover:text-slate-200 transition-all text-center"
            >
              Application Web
            </button>
            <button
              type="button"
              data-type="Refonte / Autre"
              class="project-chip col-span-2 sm:col-span-1 text-xs font-medium py-2 px-3 rounded-xl border border-slate-800 bg-slate-950/60 text-slate-400 hover:border-slate-700 hover:text-slate-200 transition-all text-center"
            >
              Refonte / Autre
            </button>
          </div>
          <input type="hidden" id="selected-project-type" name="projectType" value="Site Vitrine" />
        </div>

        <!-- Nom & Email -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="contact-name" class="block text-xs font-mono uppercase tracking-wider text-slate-300">
              Votre Nom <span class="text-emerald-400">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              required
              placeholder="ex: Alex Dupont"
              class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-all"
            />
          </div>
          <div class="space-y-1.5">
            <label for="contact-email" class="block text-xs font-mono uppercase tracking-wider text-slate-300">
              Votre Email <span class="text-emerald-400">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              required
              placeholder="ex: alex@entreprise.fr"
              class="w-full bg-slate-950/80 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-all"
            />
          </div>
        </div>

        <!-- Message -->
        <div class="space-y-1.5">
          <label for="contact-message" class="block text-xs font-mono uppercase tracking-wider text-slate-300">
            Détails de votre projet <span class="text-emerald-400">*</span>
          </label>
          <textarea
            id="contact-message"
            rows="3"
            required
            placeholder="Parlez-moi de vos attentes, vos délais souhaités ou de votre activité..."
            class="w-full bg-slate-950/80 border border-slate-800 rounded-xl p-4 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400 transition-all resize-none"
          ></textarea>
        </div>

        <!-- Bouton d'action -->
        <div class="pt-2 flex flex-col sm:flex-row items-center gap-3 justify-between">
          <button
            type="submit"
            class="btn-premium-primary w-full sm:w-auto justify-center group"
          >
            <span>Envoyer ma demande</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
          <button
            type="button"
            id="copy-direct-email"
            class="text-xs text-slate-400 hover:text-emerald-400 font-mono transition-colors flex items-center gap-1.5 py-1 px-2"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span id="copy-text-label">Copier contact@neuralcraft.fr</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ÉTAT 2 : Confirmation de Succès -->
    <div id="contact-success" class="relative z-10 py-12 text-center space-y-5 hidden">
      <div class="w-16 h-16 mx-auto rounded-full bg-emerald-500/10 border-2 border-emerald-400 flex items-center justify-center text-emerald-400 shadow-[0_0_30px_rgba(52,211,153,0.3)]">
        <svg class="w-8 h-8 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div class="space-y-2">
        <h3 class="text-2xl font-extrabold tracking-tight text-slate-100">Message envoyé !</h3>
        <p class="text-slate-400 text-sm max-w-sm mx-auto leading-relaxed">
          Merci pour votre message. Nous avons ouvert votre messagerie pour transmettre votre demande à <span class="text-emerald-400 font-mono">contact@neuralcraft.fr</span>.
        </p>
      </div>
      <button
        type="button"
        id="contact-success-close"
        class="btn-premium-secondary"
      >
        <span>Fermer</span>
      </button>
    </div>
  </div>
</div>

<script>
  function setupContactModal() {
    const modal = document.getElementById("contact-modal");
    const card = document.getElementById("contact-modal-card");
    const closeBtn = document.getElementById("contact-modal-close");
    const successCloseBtn = document.getElementById("contact-success-close");
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const formContainer = document.getElementById("contact-form-container");
    const successContainer = document.getElementById("contact-success");
    const copyBtn = document.getElementById("copy-direct-email");
    const copyLabel = document.getElementById("copy-text-label");
    const chips = document.querySelectorAll<HTMLButtonElement>(".project-chip");
    const hiddenType = document.getElementById("selected-project-type") as HTMLInputElement | null;

    if (!modal || !card) return;

    const openModal = (e?: Event) => {
      if (e) e.preventDefault();
      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.setAttribute("aria-hidden", "false");
      card.classList.remove("scale-95");
      card.classList.add("scale-100");
      document.body.style.overflow = "hidden";

      // Reset state if reopened
      if (formContainer && successContainer) {
        formContainer.classList.remove("hidden");
        successContainer.classList.add("hidden");
      }
    };

    const closeModal = () => {
      modal.classList.add("opacity-0", "pointer-events-none");
      modal.setAttribute("aria-hidden", "true");
      card.classList.add("scale-95");
      card.classList.remove("scale-100");
      document.body.style.overflow = "";
    };

    // Attach open triggers across the app
    document.querySelectorAll("[data-open-contact]").forEach((btn) => {
      btn.addEventListener("click", openModal);
    });

    closeBtn?.addEventListener("click", closeModal);
    successCloseBtn?.addEventListener("click", closeModal);

    // Close on backdrop click
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.getAttribute("aria-hidden") === "false") {
        closeModal();
      }
    });

    // Project type chips selection
    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) => {
          c.classList.remove("active", "border-emerald-500/60", "bg-emerald-500/10", "text-emerald-300");
          c.classList.add("border-slate-800", "bg-slate-950/60", "text-slate-400");
        });
        chip.classList.add("active", "border-emerald-500/60", "bg-emerald-500/10", "text-emerald-300");
        chip.classList.remove("border-slate-800", "bg-slate-950/60", "text-slate-400");
        if (hiddenType) hiddenType.value = chip.dataset.type || "Projet";
      });
    });

    // Copy email helper
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText("contact@neuralcraft.fr");
        if (copyLabel) copyLabel.textContent = "✓ Adresse copiée !";
        setTimeout(() => {
          if (copyLabel) copyLabel.textContent = "Copier contact@neuralcraft.fr";
        }, 2500);
      } catch (err) {
        // Fallback
      }
    });

    // Form submission -> prepare mailto with structured template
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const name = (document.getElementById("contact-name") as HTMLInputElement)?.value || "";
      const email = (document.getElementById("contact-email") as HTMLInputElement)?.value || "";
      const type = hiddenType?.value || "Projet";
      const message = (document.getElementById("contact-message") as HTMLTextAreaElement)?.value || "";

      const subject = encodeURIComponent(`[Contact NeuralCraft] Nouveau projet (${type}) - ${name}`);
      const body = encodeURIComponent(
        `Bonjour,\n\nNom / Entreprise : ${name}\nEmail : ${email}\nType de projet : ${type}\n\nDescription du projet :\n${message}\n\nCordialement,\n${name}`
      );

      // Ouvrir le client mail pré-rempli
      window.location.href = `mailto:contact@neuralcraft.fr?subject=${subject}&body=${body}`;

      // Afficher confirmation
      if (formContainer && successContainer) {
        formContainer.classList.add("hidden");
        successContainer.classList.remove("hidden");
      }
    });
  }

  setupContactModal();
  document.addEventListener("astro:after-swap", setupContactModal);
</script>

<style>
  .custom-modal-scroll::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
  .custom-modal-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

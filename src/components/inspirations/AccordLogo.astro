---
const { compact = false } = Astro.props;
---
<span class:list={['accord-logo', { compact }]}>
  <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M6 39 21 9l15 30M13 27h17" stroke="currentColor" stroke-width="4" stroke-linecap="square" stroke-linejoin="miter"/><path d="m27 21 15-15m-11 0h11v11" stroke="currentColor" stroke-width="4" stroke-linejoin="miter"/></svg>
  {!compact && <span>accord<small>EXPERTISE COMPTABLE</small></span>}
</span>
<style>.accord-logo{display:inline-flex;align-items:center;gap:12px;color:inherit;text-align:left;line-height:1}.accord-logo svg{width:46px;height:46px;flex-shrink:0}.accord-logo>span{font:700 30px 'Manrope',sans-serif;letter-spacing:-1.3px}.accord-logo small{display:block;font:500 7px 'DM Sans',sans-serif;letter-spacing:1.6px;margin-top:7px}.compact svg{width:100%;height:100%}</style>

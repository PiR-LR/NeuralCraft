---
import AccordLogo from './AccordLogo.astro';
import DemoHeader from './DemoHeader.astro';
import { photo } from '../../data/inspirations';

const { variant, direction } = Astro.props;
const expertises = [
  {title:'Comptabilité & comptes annuels',text:'Tenue et révision comptable, préparation du bilan et suivi régulier de vos comptes.',tags:'Comptes annuels · Reporting'},
  {title:'Fiscalité de l’entreprise',text:'Préparation des déclarations, suivi des échéances et accompagnement de vos décisions fiscales.',tags:'TVA · Déclarations · Échéances'},
  {title:'Paie & gestion sociale',text:'Bulletins de paie, déclarations sociales et suivi administratif de vos collaborateurs.',tags:'Paie · DSN · Administration'},
  {title:'Gestion & accompagnement',text:'Prévisions de trésorerie, tableaux de bord et aide à la création ou à l’évolution de votre société.',tags:'Trésorerie · Prévisionnel · Création'},
];
---
<div class={`accord-site accord-layout-${variant}`}>
  <DemoHeader metier="comptable" variant={variant} brand="accord"/>
  <main>
    <section class="accord-hero">
      <div class="accord-hero-copy"><p class="accord-kicker">Votre partenaire comptable, fiscal et social</p><h1>La gestion de votre société.<br/><em>En bonnes mains.</em></h1><p class="accord-lead">De la comptabilité à la paie, un interlocuteur pour suivre vos obligations, comprendre vos chiffres et accompagner vos décisions.</p><div class="accord-actions"><a class="accord-button" href="#contact">Échanger avec le cabinet <span aria-hidden="true">→</span></a><a class="accord-text-link" href="#expertises">Découvrir nos expertises</a></div><ul class="accord-assurances"><li>Un interlocuteur dédié</li><li>Un suivi tout au long de l’année</li></ul></div>
      <div class="accord-hero-visual"><img src={photo('https://images.pexels.com/photos/7681077/pexels-photo-7681077.jpeg',1200)} alt="Documents comptables, graphiques et analyse financière" fetchpriority="high"/><div class="accord-visual-caption"><span class="accord-mark"><AccordLogo compact/></span><div><strong>Des comptes suivis.<br/>Des décisions éclairées.</strong><span>Comptabilité · Fiscalité · Gestion sociale</span></div></div></div>
    </section>
    <section class="accord-financial-scene" aria-label="Exemple illustratif de suivi de gestion"><div class="accord-financial-intro"><p class="accord-kicker">Vos chiffres, au quotidien</p><h2>Lire. Anticiper.<br/>Décider.</h2><p>Une lecture partagée de votre activité pour préparer les prochaines étapes.</p></div><div class="accord-report"><div class="accord-report-title"><span>Suivi de trésorerie</span><small>Illustration · données fictives</small></div><svg class="accord-chart" viewBox="0 0 420 150" role="img" aria-label="Exemple illustratif d’évolution de la trésorerie"><path class="chart-grid" d="M10 30h400M10 70h400M10 110h400"/><path class="chart-area" d="M10 120 75 105 140 112 205 75 270 88 335 45 410 25V140H10Z"/><path class="chart-line" d="M10 120 75 105 140 112 205 75 270 88 335 45 410 25"/><circle cx="410" cy="25" r="5"/></svg><div class="accord-report-months"><span>Jan.</span><span>Fév.</span><span>Mars</span><span>Avr.</span><span>Mai</span><span>Juin</span></div></div><div class="accord-document-stack"><div class="accord-document"><span>Votre dossier</span><strong>Une vue d’ensemble.</strong><ul><li><i></i>Pièces comptables</li><li><i></i>Déclarations fiscales</li><li><i></i>Suivi des échéances</li></ul><small>Exemple de présentation</small></div></div></section>
    <div class="accord-service-strip"><span>TPE & PME</span><span>Indépendants</span><span>Créateurs d’entreprise</span><a href="#expertises">Un accompagnement adapté à votre activité →</a></div>
    <section id="expertises" class="accord-section accord-expertises"><div class="accord-section-heading"><div><p class="accord-kicker">Nos expertises</p><h2>Les sujets essentiels.<br/>Un suivi coordonné.</h2></div><p>Vos obligations administratives et fiscales s’inscrivent dans le quotidien de votre entreprise. Nous vous aidons à les organiser et à les anticiper.</p></div><div class="accord-expertise-grid">{expertises.map((expertise,index)=><article><svg class="accord-service-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="6" y="3" width="20" height="26" rx="2" stroke="currentColor" stroke-width="1.5"/><path d={['M11 10h10M11 16h10M11 22h5','M11 10h10M11 16h10M16 7v17','M10 22c0-7 12-7 12 0M16 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6','m10 22 5-6 4 2 4-8'][index]} stroke="currentColor" stroke-width="1.5"/></svg><h3>{expertise.title}</h3><p>{expertise.text}</p><small>{expertise.tags}</small><a href="#contact">Parlons de vos besoins <span aria-hidden="true">→</span></a></article>)}</div></section>
    <section id="cabinet" class="accord-section accord-cabinet"><div class="accord-cabinet-photo"><img src={photo('https://images.pexels.com/photos/8296970/pexels-photo-8296970.jpeg',1100)} alt="Analyse de documents comptables à l’aide d’une calculatrice" loading="lazy"/></div><div><p class="accord-kicker">Le cabinet</p><h2>Une relation directe.<br/>Une vision claire de votre activité.</h2><p>Un dossier bien suivi, ce sont des échanges réguliers et des informations compréhensibles. Nous prenons le temps de connaître votre entreprise et de vous expliquer les points qui nécessitent votre attention.</p><ul><li>Des échanges adaptés à votre organisation</li><li>Des documents et des échéances centralisés</li><li>Un accompagnement au-delà du bilan annuel</li></ul><a class="accord-text-link" href="#contact">Faire connaissance avec le cabinet →</a></div></section>
    <section id="methode" class="accord-section accord-method"><p class="accord-kicker">Notre méthode</p><h2>Un cadre simple,<br/>dès le premier échange.</h2><div>{[{title:'Comprendre votre situation',text:'Votre activité, votre organisation et les sujets que vous souhaitez nous confier.'},{title:'Définir notre mission',text:'Un périmètre clair, les documents nécessaires et un calendrier partagé.'},{title:'Assurer le suivi',text:'Des points réguliers pour suivre les échéances et répondre à vos questions.'}].map((step,index)=><article><span>0{index+1}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></section>
    <section class="accord-section accord-faq"><p class="accord-kicker">Questions fréquentes</p><h2>Avant de nous rencontrer.</h2><details><summary>Puis-je vous confier seulement certaines missions ?</summary><p>Le premier échange permet de définir les missions adaptées à votre organisation : comptabilité, fiscalité, paie ou suivi de gestion.</p></details><details><summary>Comment se déroule la transmission des documents ?</summary><p>Les modalités de collecte et le calendrier sont définis ensemble au début de la mission, selon vos outils et vos habitudes.</p></details><details><summary>Accompagnez-vous les créations d’entreprise ?</summary><p>Le cabinet peut accompagner la préparation de votre projet, la construction du prévisionnel et l’organisation du suivi comptable.</p></details></section>
    <section id="contact" class="accord-contact demo-contact"><div><p class="accord-kicker">Parlons de votre entreprise</p><h2>De quoi avez-vous besoin ?</h2><p>Comptabilité, fiscalité, paie ou création d’entreprise : un premier échange pour faire le point sur votre situation.</p></div><a href={`/inspirations/comptable?direction=${direction.id}#parlons`} target="_top" class="accord-button">Imaginer ce site pour mon cabinet →</a><small>Cabinet fictif — concept de démonstration NeuralCraft. Ce bouton vous met en relation avec NeuralCraft pour votre projet web.</small></section>
  </main>
  <footer class="accord-footer"><AccordLogo/><span>Concept fictif par NeuralCraft · 2026</span><a href="#">Retour en haut ↑</a></footer>
</div>

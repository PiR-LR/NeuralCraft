---
import Logo from '../Logo.astro';
import { inspirations } from '../../data/inspirations';
const { item, direction } = Astro.props;
---
<aside class="concept-bar preview-bar" data-preview-bar data-metier={item.id} data-registry={JSON.stringify(inspirations)}>
  <a href="/inspirations" target="_top" class="preview-brand"><Logo id="preview-neuralcraft" class="preview-logo" autoplay={false}/><span>Neural<span>Craft</span></span></a>
  <span class="preview-notice">Concept de démonstration</span>
  <div class="preview-settings">
    <label>Site<select data-preview-site aria-label="Choisir le site">{inspirations.map(site=><option value={site.id} selected={site.id===item.id}>{site.brand}</option>)}</select></label>
    <label>Modèle<select data-preview-direction aria-label="Choisir le modèle">{item.directions.map(model=><option value={model.id} selected={model.id===direction.id}>{model.label}</option>)}</select></label>
    <label>Couleurs<select data-preview-palette aria-label="Choisir les couleurs">{item.palettes.map(palette=><option value={palette.id}>{palette.label}</option>)}</select></label>
  </div>
  <a class="preview-back" href={`/inspirations/${item.id}`} target="_top" data-preview-back>Retour aux inspirations</a>
</aside>
<script>
  import '../../scripts/preview-bar';
</script>
<style is:global>
  .preview-bar.concept-bar{position:sticky;top:0;z-index:80;background:#020617;color:#e2e8f0;border-bottom:1px solid #334155;display:flex;align-items:center;gap:18px;padding:12px 24px;font:12px 'DM Sans',sans-serif;letter-spacing:0;min-height:64px}
  .preview-logo{color:#34d399}.preview-logo [data-logo-core]{fill:#34d399}
  .preview-brand{display:flex;align-items:center;gap:9px;flex-shrink:0}.preview-brand>span{font:800 17px Manrope,sans-serif;letter-spacing:-.5px}.preview-brand>span>span{color:#34d399}.preview-logo{position:relative;width:30px;height:30px;flex-shrink:0}.preview-logo canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.preview-logo svg{position:relative;width:100%;height:100%}.preview-notice{font-size:10px;color:#94a3b8}.preview-settings{display:flex;align-items:center;gap:12px;margin-left:auto}.preview-settings label{display:flex;align-items:center;gap:7px;color:#94a3b8;font-size:10px}.preview-settings select{background:#0f172a;color:#f1f5f9;border:1px solid #334155;border-radius:7px;padding:8px 26px 8px 10px;font:500 11px 'DM Sans',sans-serif;max-width:160px;cursor:pointer}.preview-settings select:hover{border-color:#34d399}.preview-settings select:focus-visible,.preview-bar a:focus-visible{outline:2px solid #34d399;outline-offset:3px}.preview-back{font-size:10px;color:#6ee7b7;flex-shrink:0}.preview-back:hover{color:#34d399;text-decoration:underline}
  .dh-cabinet,.dh-editorial.has-reserved-space.is-scrolled,.dh-ledger.is-scrolled,.dh-immersive.is-scrolled{top:var(--preview-height,64px)!important}.dh-ledger{top:var(--preview-height,64px)}.dh-float{top:calc(var(--preview-height,64px) + 12px)}.decorateur .dh-immersive,.dh-atelier{top:var(--preview-height,64px)}.dh-atelier.is-scrolled{top:var(--preview-height,64px)}.dh-tiles.is-scrolled .dh-toggle{top:calc(var(--preview-height,64px) + 12px)}.scroll-ruler{top:var(--preview-height,64px);z-index:35}.dh-dialog{z-index:100}
  @media(max-width:1100px){.preview-notice{display:none}.preview-bar.concept-bar{gap:12px;padding-inline:15px}.preview-settings label{flex-direction:column;align-items:start;gap:4px}.preview-settings select{max-width:140px}}
  @media(max-width:700px){.preview-bar.concept-bar{flex-wrap:wrap;padding:10px 12px;gap:10px;min-height:0}.preview-brand>span{font-size:15px}.preview-logo{width:25px;height:25px}.preview-back{margin-left:auto;font-size:9px}.preview-settings{width:100%;margin:0;gap:7px}.preview-settings label{flex:1;min-width:0;font-size:9px}.preview-settings select{width:100%;max-width:none;min-width:0;font-size:10px;padding:8px}.preview-bar>span{max-width:none;text-align:left}.dh-ledger{top:var(--preview-height,110px)}.ruler-range{top:24px;bottom:24px;height:calc(100% - 48px)}}
</style>

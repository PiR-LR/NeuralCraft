---
// src/pages/services.astro
import Layout from '../layouts/Layout.astro';

const coreServices = [
  {
    id: 'service-0', num: '01', badge: 'Présenter votre activité',
    title: 'Sites vitrines', subtitle: 'Votre activité, clairement présentée',
    description: 'Présenter une activité, une entreprise, une association ou un projet avec un site soigné, rapide et facile à utiliser.',
    points: ['Un design à votre image', 'Vos services et informations faciles à trouver', 'Une navigation adaptée au mobile', 'Une prise de contact simple'],
  },
  {
    id: 'service-1', num: '02', badge: 'Aller au-delà des pages',
    title: 'Sites et plateformes sur mesure', subtitle: 'Les fonctionnalités dont vous avez besoin',
    description: 'Quand un site de présentation ne suffit plus, je construis les espaces et fonctionnalités utiles à vos visiteurs, vos membres ou votre équipe.',
    points: ['Espaces membres et profils utilisateurs', 'Formulaires avancés et réservations', 'Gestion de contenu et administration', 'Emailing et suivi des données'],
  },
  {
    id: 'service-2', num: '03', badge: 'Créer votre outil de travail',
    title: 'Applications web et outils métier', subtitle: 'Un outil construit autour de vos usages',
    description: 'Transformer une idée, un processus ou un besoin spécifique en application. Par exemple, remplacer un tableur devenu difficile à gérer ou faciliter le travail de plusieurs utilisateurs.',
    points: ['Tableaux de bord et gestion de données', 'Calculs et règles propres à votre activité', 'Collaboration et interactions en temps réel', 'Automatisations et connexion à vos outils'],
  }
];
---

<Layout
  title="Sites vitrines et applications web"
  description="Conception de sites vitrines modernes, webapps métiers et optimisation de performances. Des solutions stables, rapides et adaptées à vos objectifs."
>

  <div class="relative w-full md:min-h-[420vh]" id="scroll-container">

    <!-- ═══ HERO MOBILE (statique, scroll normal) ═══ -->
    <div class="md:hidden px-6 pt-14 pb-10 text-center space-y-6">
      <span class="inline-block text-xs font-mono uppercase tracking-widest px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        Mes services
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight leading-[1.1]">
        Du site vitrine à l’application métier : <br/>
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">le bon format pour votre projet.</span>
      </h1>
      <p class="text-slate-400 text-base leading-relaxed">
        Je vous aide à présenter votre activité en ligne ou à développer un outil adapté à vos besoins.
      </p>
    </div>

    <!-- ═══ CARTES MOBILE (flux vertical normal) ═══ -->
    <div class="md:hidden px-6 pb-16 space-y-6">
      {coreServices.map((service) => (
        <article class="relative overflow-hidden bg-slate-900 border border-slate-800 rounded-3xl p-6 space-y-5">
          <div class="absolute -right-2 -bottom-6 text-8xl font-extrabold text-slate-800/30 select-none font-mono pointer-events-none">
            {service.num}
          </div>

          <div class="relative z-10 space-y-1.5">
            <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold">{service.badge}</span>
            <h2 class="text-2xl font-extrabold tracking-tight text-slate-100">{service.title}</h2>
            <p class="text-xs font-mono text-slate-400">{service.subtitle}</p>
          </div>

          <p class="relative z-10 text-slate-300 text-sm leading-relaxed">{service.description}</p>

          <ul class="relative z-10 space-y-2.5">
            {service.points.map((point) => (
              <li class="flex items-center gap-3 text-xs text-slate-300 font-medium">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
                {point}
              </li>
            ))}
          </ul>



          <button
            type="button"
            data-open-contact
            class="btn-cyber-secondary w-full relative z-10 cursor-pointer"
          >
            <span>Parlons de votre projet</span>
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </article>
      ))}
    </div>

    <!-- ═══ HERO DESKTOP UNIQUE (fixe, transitionne vers le haut au scroll) ═══ -->
    <div
      id="hero-box"
      class="hidden md:flex md:fixed left-1/2 w-full max-w-6xl px-6 z-40 text-center flex-col items-center pointer-events-none transition-all duration-700 ease-out origin-top"
      style="top: 85px; transform: translate(-50%, calc(35vh - 85px)) scale(1);"
    >
      <div id="hero-badge" class="transition-opacity duration-500 mb-6">
        <span class="inline-block text-xs font-mono uppercase tracking-widest px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          Mes services
        </span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] w-full" id="hero-title">
        Du site vitrine à l’application métier : <br/>
        <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">le bon format pour votre projet.</span>
      </h1>

      <p class="text-slate-400 text-base md:text-xl max-w-3xl mx-auto font-normal leading-relaxed mt-6 transition-opacity duration-500" id="hero-subtitle">
        Je vous aide à présenter votre activité en ligne ou à développer un outil adapté à vos besoins.
      </p>

      <div class="pt-8 animate-bounce transition-opacity duration-500" id="hero-scroll-hint">
        <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Défiler pour explorer</span>
      </div>
    </div>

    <!-- ═══ ZONE DES CARTES DESKTOP (z-30) : Placée sous le titre sans mordre dessus ═══ -->
    <div id="cards-zone" class="hidden md:block md:fixed top-[32vh] lg:top-[34vh] left-1/2 -translate-x-1/2 w-full max-w-5xl px-6 z-30 pointer-events-none">
      {coreServices.map((service) => (
        <div 
          id={service.id}
          class="service-card absolute left-0 right-0 mx-6 bg-slate-900 border border-slate-800 rounded-3xl p-8 md:p-12 shadow-2xl transition-all duration-700 ease-out opacity-0 translate-y-16 pointer-events-none"
        >
          <!-- Filigrane Numéro -->
          <div class="absolute -right-4 -bottom-8 text-9xl font-extrabold text-slate-800/30 select-none font-mono pointer-events-none">
            {service.num}
          </div>

          <div class="flex flex-col lg:flex-row gap-8 justify-between items-start relative z-10">
            
            <div class="space-y-5 max-w-2xl">
              <div class="space-y-1.5">
                <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold">{service.badge}</span>
                <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight text-slate-100">{service.title}</h2>
                <p class="text-xs font-mono text-slate-400">{service.subtitle}</p>
              </div>

              <p class="text-slate-300 text-sm md:text-base leading-relaxed">{service.description}</p>

              <ul class="space-y-2.5 pt-2">
                {service.points.map((point) => (
                  <li class="flex items-center gap-3 text-xs md:text-sm text-slate-300 font-medium">
                    <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {point}
                  </li>
                ))}
              </ul>
            </div>

            <div class="w-full lg:w-auto flex flex-col justify-between items-start lg:items-end gap-6 h-full">


              <button
                type="button"
                data-open-contact
                class="btn-cyber-secondary w-full lg:w-auto pointer-events-auto cursor-pointer"
              >
                <span>Parlons de votre projet</span>
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>

  <section class="technical-section" aria-labelledby="technical-title">
    <div class="technical-panel">
      <div class="technical-intro">
        <span class="technical-eyebrow"><span></span> Le choix des outils</span>
        <h2 id="technical-title">Votre projet donne<br />le <span>cap.</span></h2>
        <p>Je choisis les technologies en fonction de ce que vous voulez construire, de vos usages et de la suite du projet.</p>
        <span class="technical-signature">Le besoin d’abord. Les outils ensuite.</span>
      </div>
      <div class="technical-content">
        <div class="technical-row">
          <span class="technical-number" aria-hidden="true">01</span>
          <div><h3>Une expérience soignée</h3><p>Des pages lisibles, rapides et agréables à utiliser.</p></div>
        </div>
        <div class="technical-row">
          <span class="technical-number" aria-hidden="true">02</span>
          <div><h3>Des fonctionnalités utiles</h3><p>Les bons outils pour vos utilisateurs et votre activité.</p></div>
        </div>
        <div class="technical-row">
          <span class="technical-number" aria-hidden="true">03</span>
          <div><h3>Une base pour évoluer</h3><p>Des choix adaptés aux prochaines étapes de votre projet.</p></div>
        </div>
        <details class="technical-details">
          <summary>
            <span>Pour les curieux : sous le capot</span>
            <span class="technical-toggle" aria-hidden="true">+</span>
          </summary>
          <div class="technical-tools">
            {['Astro', 'Next.js', 'TypeScript', 'Supabase', 'PostgreSQL', 'MongoDB', 'Cloudflare', 'Socket.io'].map((tool) => <span>{tool}</span>)}
          </div>
          <p>Une sélection d’outils que j’utilise selon les projets.</p>
        </details>
      </div>
    </div>
  </section>

  <style>
    .technical-section { position: relative; z-index: 50; padding: 5rem 1.5rem; background: #020617; }
    .technical-panel { position: relative; max-width: 1120px; margin: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; padding: 3.5rem; border: 1px solid #1e293b; border-radius: 2rem; background: radial-gradient(ellipse at 0% 0%, rgba(52,211,153,.07), transparent 60%), #080f1e; }
    .technical-eyebrow { display: inline-flex; align-items: center; gap: .65rem; color: #6ee7b7; font-size: .65rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; }
    .technical-eyebrow > span { width: .4rem; height: .4rem; background: #34d399; border-radius: 50%; box-shadow: 0 0 12px #34d39960; }
    .technical-intro h2 { margin: 1.5rem 0; color: #f1f5f9; font-size: clamp(2rem, 3.7vw, 3.25rem); line-height: 1.12; font-weight: 800; letter-spacing: -.055em; }
    .technical-intro h2 span { color: #6ee7b7; }
    .technical-intro > p { max-width: 360px; color: #94a3b8; font-size: .95rem; line-height: 1.85; }
    .technical-signature { display: block; margin-top: 2rem; color: #cbd5e1; font-size: .75rem; }
    .technical-row { display: flex; gap: 1.25rem; padding: 1.25rem 0; border-bottom: 1px solid #1e293b; }
    .technical-row:first-child { padding-top: 0; }
    .technical-number { padding-top: .2rem; color: #34d399; font-family: 'JetBrains Mono', monospace; font-size: .65rem; }
    .technical-row h3 { color: #e2e8f0; font-size: .95rem; font-weight: 600; letter-spacing: -.02em; }
    .technical-row p { margin-top: .4rem; color: #94a3b8; font-size: .8rem; line-height: 1.7; }
    .technical-details { margin-top: 1.25rem; }
    .technical-details summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; cursor: pointer; color: #94a3b8; font-size: .75rem; list-style: none; border-radius: .25rem; transition: color .2s; }
    .technical-details summary::-webkit-details-marker { display: none; }
    .technical-details summary:hover { color: #6ee7b7; }
    .technical-details summary:focus-visible { outline: 2px solid #34d399; outline-offset: 6px; }
    .technical-toggle { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border: 1px solid #334155; border-radius: 50%; color: #6ee7b7; font-size: 1rem; transition: transform .2s; }
    .technical-details[open] .technical-toggle { transform: rotate(45deg); }
    .technical-tools { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.25rem; }
    .technical-tools span { border: 1px solid #263448; background: #0b1526; border-radius: .5rem; padding: .4rem .7rem; color: #cbd5e1; font-size: .7rem; }
    .technical-details > p { margin-top: .8rem; color: #94a3b8; font-size: .7rem; line-height: 1.6; }
    @media (max-width: 767px) {
      .technical-section { padding: 3rem 1.5rem; }
      .technical-panel { grid-template-columns: 1fr; gap: 2rem; padding: 1.75rem; border-radius: 1.5rem; }
      .technical-signature { margin-top: 1.25rem; }
    }
    @media (prefers-reduced-motion: reduce) { .technical-toggle, .technical-details summary { transition: none; } }
  </style>

  <!-- ═══ SECTION CONTACT FINALE (Plein écran centré) ═══ -->
  <section id="contact-section" class="relative z-50 min-h-screen flex items-center justify-center px-6 py-20 overflow-hidden border-t border-slate-900 bg-slate-950">
    <div class="absolute inset-0 bg-emerald-500/5 blur-3xl rounded-full pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center space-y-8 relative z-10 -translate-y-6 md:translate-y-0">
      <div class="space-y-4">
        <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold">Parlons de votre projet</span>
        <h2 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold tracking-tight text-slate-100">
          Que souhaitez-vous créer ?
        </h2>
        <p class="text-slate-400 text-base md:text-xl max-w-2xl mx-auto font-normal leading-relaxed">
          Un site pour votre activité, une refonte ou une application : décrivez-moi votre besoin.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-5 pt-6">
        <button
          type="button"
          data-open-contact
          class="btn-cyber-primary w-full sm:w-auto cursor-pointer group"
        >
          <svg class="w-5 h-5 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span>Prendre contact</span>
        </button>

        <a href="/projets" class="btn-cyber-secondary w-full sm:w-auto group">
          <span>Voir les réalisations</span>
          <svg class="w-5 h-5 text-emerald-400 group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ SCRIPT PROPRE ET FIABLE ═══ -->
  <script>
    let servicesScrollCleanup: (() => void) | null = null;

    function initCleanServicesScroll() {
      if (servicesScrollCleanup) {
        servicesScrollCleanup();
        servicesScrollCleanup = null;
      }

      const isMobile = () => window.innerWidth < 768;

      const heroBox = document.getElementById('hero-box');
      const heroBadge = document.getElementById('hero-badge');
      const heroSubtitle = document.getElementById('hero-subtitle');
      const heroScrollHint = document.getElementById('hero-scroll-hint');

      const cards = [
        document.getElementById('service-0'),
        document.getElementById('service-1'),
        document.getElementById('service-2')
      ];

      function onScroll() {
        if (isMobile()) return;

        const scrollY = window.scrollY;
        const vh = window.innerHeight;

        // 1. GESTION DU TITRE : Toggle via CSS Transform (Garantit 2 lignes et place fixe à 85px)
        if (scrollY > 50) {
          if (heroBox) {
            heroBox.style.transform = 'translate(-50%, 0) scale(0.65)';
            heroBox.style.opacity = scrollY > vh * 2.8 ? '0' : '1';
          }
          if (heroBadge) heroBadge.style.opacity = '0';
          if (heroSubtitle) heroSubtitle.style.opacity = '0';
          if (heroScrollHint) heroScrollHint.style.opacity = '0';
        } else {
          // Centrage initial calculé
          if (heroBox) {
            heroBox.style.transform = 'translate(-50%, calc(35vh - 85px)) scale(1)';
            heroBox.style.opacity = '1';
          }
          if (heroBadge) heroBadge.style.opacity = '1';
          if (heroSubtitle) heroSubtitle.style.opacity = '1';
          if (heroScrollHint) heroScrollHint.style.opacity = '1';
        }

        // 2. APPARITION DES CARTES
        const step1 = vh * 0.4;
        const step2 = vh * 1.4;
        const step3 = vh * 2.4;
        const exitStep = vh * 3.3;

        cards.forEach((card) => {
          if (card) {
            card.classList.add('opacity-0', 'translate-y-16');
            card.classList.remove('opacity-100', 'translate-y-0');
            card.style.pointerEvents = 'none'; 
          }
        });

        if (scrollY >= exitStep) {
          // Sortie douce quand le CTA final arrive
        } else if (scrollY >= step3) {
          showCard(cards[2]);
        } else if (scrollY >= step2) {
          showCard(cards[1]);
        } else if (scrollY >= step1) {
          showCard(cards[0]);
        }
      }

      function showCard(card: HTMLElement | null) {
        if (card) {
          card.classList.remove('opacity-0', 'translate-y-16');
          card.classList.add('opacity-100', 'translate-y-0');
          card.style.pointerEvents = 'auto';
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll(); // Force l'état initial

      servicesScrollCleanup = () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      };
    }

    initCleanServicesScroll();
    document.addEventListener('astro:after-swap', initCleanServicesScroll);
  </script>

</Layout>

---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";

const highlights = [
  { label: "Présenter votre activité", value: "Sites vitrines", sub: "Design soigné et contenu clair" },
  { label: "Connecter vos utilisateurs", value: "Plateformes", sub: "Espaces membres et gestion de contenu" },
  { label: "Faciliter votre travail", value: "Outils métier", sub: "Des fonctionnalités adaptées à vos usages" },
];
---

<Layout
  title="Développement de Sites Web & Applications Sur-Mesure"
  description="NeuralCraft conçoit des sites web et applications sur-mesure : design soigné, navigation claire et fonctionnalités adaptées à votre activité."
>
  <!-- SLIDE 1 : HERO LOGO INTERACTIF -->
  <section
    class="min-h-[calc(100svh-5rem)] md:min-h-[calc(100vh-5rem)] w-full flex flex-col items-center justify-center relative bg-slate-950 px-6 overflow-hidden"
  >
    <div class="flex flex-col items-center justify-center -translate-y-6 md:translate-y-0 z-10">
      <button
        id="logo-trigger"
        class="py-2 relative group cursor-pointer outline-none border-none bg-transparent"
        title="Découvrir mes services"
      >
        <div
          class="absolute inset-0 bg-emerald-500/30 blur-3xl rounded-full opacity-60 group-hover:opacity-100 transition-opacity"
        >
        </div>
        <Logo
          id="main-hero-svg"
          class="w-44 h-44 sm:w-56 sm:h-56 md:w-72 md:h-72 relative z-10 mx-auto group-hover:scale-105 transition-transform duration-300"
        />
      </button>

      <div class="text-center space-y-2 mt-3 z-10">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight">
          Des solutions web pensées pour votre projet.
        </h1>
        <p class="text-slate-400 font-mono text-xs uppercase tracking-widest">
          Du site vitrine à l’application métier
        </p>
        <p class="text-slate-300 text-base md:text-lg max-w-2xl mx-auto leading-relaxed pt-4">
          Je conçois des expériences web sur mesure, adaptées à vos besoins et à vos utilisateurs.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-6">
          <a href="/projets" class="btn-cyber-secondary">Découvrir mes réalisations</a>
          <button type="button" data-open-contact class="btn-cyber-primary cursor-pointer">Parler de votre projet</button>
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-6 md:bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-400 animate-bounce"
    >
      <span class="text-[10px] font-mono uppercase tracking-widest"
        >Faire défiler</span
      >
      <svg
        class="w-5 h-5 text-emerald-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- SLIDE 2 : LE NOUVEAU POSITIONNEMENT (WEAPPS LOURDES & HAUTE VOLTIGE) -->
  <section
    id="antigravity-section"
    class="min-h-screen w-full flex flex-col items-center justify-center px-4 sm:px-6 bg-slate-900/40 border-t border-slate-900 py-20 overflow-x-hidden"
  >
    <div class="space-y-12 w-full max-w-6xl mx-auto text-center scroll-reveal">
      <div class="space-y-4">
        <h2
          class="text-[11px] font-mono uppercase tracking-widest text-emerald-400"
        >
          Création de sites et applications web
        </h2>
        <h3
          class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter leading-tight md:leading-none"
        >
          Du web, pensé pour vous.<br class="hidden md:inline" />
          <span
            class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent"
          >
            Construit autour de votre besoin.
          </span>
        </h3>
        <p
          class="text-slate-300 text-sm md:text-xl max-w-3xl mx-auto font-normal leading-relaxed pt-2 px-2"
        >
          Chaque projet part d’un besoin concret. Je choisis les outils adaptés à son usage,
          à ses utilisateurs et à son évolution : un site vitrine, une plateforme
          avec des fonctionnalités spécifiques ou une application métier.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 border-t border-slate-800/60 max-w-3xl mx-auto w-full">
        {highlights.map((item) => (
          <div class="text-center space-y-2">
            <p class="text-xs text-slate-400">{item.label}</p>
            <p class="text-xl font-bold text-emerald-400">{item.value}</p>
            <p class="text-sm text-slate-400">{item.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SLIDE 3 : CTA -->
  <section
    class="min-h-screen w-full flex flex-col items-center justify-center bg-slate-950 px-6 border-t border-slate-900 relative overflow-hidden"
  >
    <!-- Halo de fond -->
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full bg-emerald-500/5 blur-[120px] animate-pulse"
      >
      </div>
    </div>

    <div
      class="space-y-10 text-center max-w-3xl mx-auto scroll-reveal relative z-10"
    >
      <div class="space-y-4">
        <span
          class="inline-block text-[10px] font-mono uppercase tracking-[0.25em] text-emerald-400/80 border border-emerald-500/20 rounded-full px-4 py-1.5 bg-emerald-500/5"
        >
          Lancement de projet
        </span>
        <h3 class="text-4xl md:text-6xl font-extrabold tracking-tighter leading-none">
  Un projet{" "}
  <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">
    web
  </span>
  <br />en vue ?
</h3>
        <p class="text-slate-400 text-base max-w-md mx-auto leading-relaxed">
          Présentez-moi votre activité et ce que vous souhaitez créer.
        </p>
      </div>

      <!-- BOUTONS PREMIUM -->
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2"
      >
        <!-- Bouton principal : glow + gradient animé -->
        <a href="/services" class="btn-premium-primary group">
          <span class="btn-premium-primary__glow"></span>
          <span class="btn-premium-primary__inner">
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span>Démarrer un projet</span>
          </span>
        </a>

        <!-- Bouton secondaire : glass + border animée -->
        <a href="/projets" class="btn-premium-secondary group">
          <span class="btn-premium-secondary__border"></span>
          <span class="btn-premium-secondary__inner">
            <span>Voir les réalisations</span>
            <svg
              class="w-4 h-4 shrink-0 group-hover:translate-x-1 transition-transform"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- SCRIPT LOGO CLIC + AUTO-REPLAY -->
<script>
  function setupLogoInteraction() {
    const triggerBtn = document.getElementById("logo-trigger");
    const svg = document.getElementById("main-hero-svg");
    const targetSection = document.getElementById("antigravity-section");
    const heroSection = triggerBtn?.closest("section");

    if (!triggerBtn || !svg) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let autoTimer: number | null = null;
    let observer: IntersectionObserver | null = null;

    const playEntrance = () => {
      const api = (svg as any).ncLogo;
      api?.playEntrance?.();
    };

    const playBurst = () => {
      const api = (svg as any).ncLogo;
      api?.playBurst?.();
    };

    const handleTriggerClick = () => {
      playBurst();
      if (targetSection) {
        window.setTimeout(() => {
          targetSection.scrollIntoView({ behavior: "smooth" });
        }, 280);
      }
    };

    const startAuto = () => {
      if (autoTimer || prefersReducedMotion) return;
      autoTimer = window.setInterval(playEntrance, 7500);
    };

    const stopAuto = () => {
      if (autoTimer !== null) {
        window.clearInterval(autoTimer);
        autoTimer = null;
      }
    };

    triggerBtn.addEventListener("click", handleTriggerClick);

    if (heroSection) {
      observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            startAuto();
          } else {
            stopAuto();
          }
        },
        { threshold: 0.3 }
      );
      observer.observe(heroSection);
    } else {
      startAuto();
    }

    // Cleanup on navigation
    const cleanup = () => {
      triggerBtn.removeEventListener("click", handleTriggerClick);
      stopAuto();
      observer?.disconnect();
    };

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }

  setupLogoInteraction();
  document.addEventListener("astro:after-swap", setupLogoInteraction);
</script>
</Layout>

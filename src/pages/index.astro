  <!-- SCRIPT LOGO CLIC + AUTO-REPLAY -->
  <script>
    function setupLogoInteraction() {
      const triggerBtn = document.getElementById("logo-trigger");
      const svg = document.getElementById("main-hero-svg");
      const targetSection = document.getElementById("antigravity-section");
      const heroSection = triggerBtn?.closest("section");

      if (!triggerBtn || !svg) return;

      // Fonction qui joue l'animation (sans scroll)
      const playAnim = () => {
        if (svg.classList.contains("deconstruct")) return; // déjà en cours
        svg.classList.add("deconstruct");
        setTimeout(() => svg.classList.remove("deconstruct"), 1200);
      };

      // Clic manuel → joue l'anim + scroll vers la section suivante
      triggerBtn.addEventListener("click", () => {
        playAnim();
        if (targetSection) {
          setTimeout(
            () => targetSection.scrollIntoView({ behavior: "smooth" }),
            250,
          );
        }
      });

      // Auto-replay toutes les 7.5 secondes quand la hero est visible
      let autoTimer: ReturnType<typeof setInterval> | null = null;

      const startAuto = () => {
        if (autoTimer) return;
        // Première frappe après 7.5s
        autoTimer = setInterval(playAnim, 7500);
      };

      const stopAuto = () => {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      };

      // IntersectionObserver — démarre/arrête selon la visibilité
      if (heroSection) {
        const observer = new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? startAuto() : stopAuto()),
          { threshold: 0.3 },
        );
        observer.observe(heroSection);
      } else {
        startAuto(); // fallback si pas de section trouvée
      }
    }

    setupLogoInteraction();
    document.addEventListener("astro:after-swap", setupLogoInteraction);
  </script>

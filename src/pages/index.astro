  { label: "Réactivité", value: "WebSockets", sub: "Event-Driven Sync" },
  { label: "Architectures", value: "Fullstack", sub: "Next.js & Supabase" },
  {
    label: "Précision",
    value: "Haute Voltige",
    sub: "Outils & Webapps Métier",
  },
];
---

<Layout
  title="Architectures Web Antigravité"
  description="NeuralCraft Engine — Je conçois des webapps ambitieuses, rapides et robustes. Fullstack Next.js, temps réel, interfaces qui impressionnent."
>
  <!-- SLIDE 1 : HERO LOGO INTERACTIF -->
  <section
    class="min-h-screen w-full flex flex-col items-center justify-center relative bg-slate-950 px-6"
  >
    <button
      id="logo-trigger"
      class="py-4 relative group cursor-pointer outline-none border-none bg-transparent"
      title="Cliquer pour initialiser le noyau"
    >
      <div
        class="absolute inset-0 bg-emerald-500/30 blur-3xl rounded-full opacity-60 group-hover:opacity-100 transition-opacity"
      >
      </div>
      <Logo
        id="main-hero-svg"
        class="w-48 h-48 md:w-72 md:h-72 relative z-10 mx-auto group-hover:scale-105 transition-transform duration-300"
      />
    </button>

    <div class="text-center space-y-2 mt-4 z-10">
      <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight">
        NeuralCraft Engine
      </h1>
      <p class="text-slate-500 font-mono text-xs uppercase tracking-widest">
        Cliquez sur le noyau ou faites défiler
      </p>
    </div>

    <div
      class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-500 animate-bounce"
    >
      <span class="text-[10px] font-mono uppercase tracking-widest"
        >Faire défiler</span
      >
      <svg
        class="w-5 h-5 text-emerald-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- SLIDE 2 : LE NOUVEAU POSITIONNEMENT (WEAPPS LOURDES & HAUTE VOLTIGE) -->
  <section
    id="antigravity-section"
    class="min-h-screen w-full flex flex-col items-center justify-center px-4 sm:px-6 bg-slate-900/40 border-t border-slate-900 py-20 overflow-x-hidden"
  >
    <div class="space-y-12 w-full max-w-6xl mx-auto text-center scroll-reveal">
      <div class="space-y-4">
        <h2
          class="text-[11px] font-mono uppercase tracking-widest text-emerald-400"
        >
          Ingénierie Fullstack & Temps Réel
        </h2>
        <h3
